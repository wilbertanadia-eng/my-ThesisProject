APP_NAME=VSULHS_SSLG
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# For local development: use local MySQL
# For Vercel production: use managed database service (AWS RDS, Render, PlanetScale, etc.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Cache Configuration
# On serverless, use 'database', 'redis', or 'memcached' instead of 'file'
CACHE_DRIVER=database
CACHE_STORE=database

# Session Configuration
# On serverless, use 'cookie', 'database', or 'redis' instead of 'file'
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false

# Queue Configuration
# On serverless, use 'sync', 'database', or 'redis' instead of 'file'
QUEUE_CONNECTION=database

# File Storage Configuration
# For production on Vercel, use external storage like S3, Cloudinary, etc.
FILESYSTEM_DISK=local

# AWS S3 Configuration (for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary Configuration (for image storage)
# CLOUDINARY_URL=

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# For Resend (in production)
# MAIL_MAILER=resend
# RESEND_API_KEY=

# For Mailgun
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=

# AWS SES
# MAIL_MAILER=ses

# Cloudinary Configuration
# USE_CLOUDINARY=false

# Backup Configuration
# BACKUP_DISK=private

# Application Maintenance
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Additional Configuration
# PHP_CLI_SERVER_WORKERS=4
